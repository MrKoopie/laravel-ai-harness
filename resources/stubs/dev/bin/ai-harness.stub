#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="${CODEX_WORKTREE_PATH:-$(cd -- "${script_dir}/../.." && pwd -P)}"

cd "${repo_root}"

herd_binary() {
    if command -v herd >/dev/null 2>&1; then
        command -v herd

        return 0
    fi

    local herd_path="${HOME}/Library/Application Support/Herd/bin/herd"

    if [[ -x "${herd_path}" ]]; then
        printf '%s\n' "${herd_path}"

        return 0
    fi

    return 1
}

uses_phpunit_configuration() {
    local argument

    for argument in "$@"; do
        case "${argument}" in
            --configuration|--configuration=*)
                return 0
                ;;
        esac
    done

    return 1
}

sail_runtime_available() {
    local app_service="${APP_SERVICE:-laravel.test}"

    [[ -x ./vendor/bin/sail ]] || return 1

    if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
        docker compose ps --status=running --services 2>/dev/null | grep -Fxq "${app_service}" && return 0
    fi

    if command -v podman >/dev/null 2>&1 && podman info >/dev/null 2>&1; then
        podman compose ps --status=running --services 2>/dev/null | grep -Fxq "${app_service}" && return 0
    fi

    return 1
}

artisan_args=("$@")
phpunit_config=".ai-harness.phpunit.xml"

if [[ "${1:-}" == "test" && -f "${phpunit_config}" ]] && ! uses_phpunit_configuration "$@"; then
    artisan_args=("test" "--configuration=${phpunit_config}" "${@:2}")
fi

if [[ "${1:-}" == "ai-harness:doctor" && ! -f vendor/autoload.php ]]; then
    printf 'ai-harness:doctor skipped: provisioning in progress; vendor/autoload.php is missing.\n' >&2
    exit 0
fi

if sail_runtime_available; then
    exec ./vendor/bin/sail artisan "${artisan_args[@]}"
fi

if herd_path="$(herd_binary)"; then
    exec "${herd_path}" php artisan "${artisan_args[@]}"
fi

exec php artisan "${artisan_args[@]}"
