#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="${CODEX_WORKTREE_PATH:-$(cd -- "${script_dir}/../.." && pwd -P)}"

cd "${repo_root}"

sail_runtime_available() {
    if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
        return 0
    fi

    command -v podman >/dev/null 2>&1 && podman info >/dev/null 2>&1
}

uses_phpunit_configuration() {
    local argument

    for argument in "$@"; do
        case "${argument}" in
            --configuration|--configuration=*)
                return 0
                ;;
        esac
    done

    return 1
}

artisan_args=("$@")
phpunit_config="${repo_root}/.codex/local-environment-state/phpunit.xml"

if [[ "${1:-}" == "test" && -f "${phpunit_config}" ]] && ! uses_phpunit_configuration "$@"; then
    artisan_args=("test" "--configuration=${phpunit_config}" "${@:2}")
fi

if [[ -x ./vendor/bin/sail ]] && sail_runtime_available; then
    exec ./vendor/bin/sail artisan "${artisan_args[@]}"
fi

if command -v herd >/dev/null 2>&1; then
    exec herd php artisan "${artisan_args[@]}"
fi

exec php artisan "${artisan_args[@]}"
