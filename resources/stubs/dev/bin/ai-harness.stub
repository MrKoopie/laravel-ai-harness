#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="${CODEX_WORKTREE_PATH:-$(cd -- "${script_dir}/../.." && pwd -P)}"

cd "${repo_root}"

herd_binary() {
    if command -v herd >/dev/null 2>&1; then
        command -v herd

        return 0
    fi

    local herd_path="${HOME}/Library/Application Support/Herd/bin/herd"

    if [[ -x "${herd_path}" ]]; then
        printf '%s\n' "${herd_path}"

        return 0
    fi

    return 1
}

uses_phpunit_configuration() {
    local argument

    for argument in "$@"; do
        case "${argument}" in
            --configuration|--configuration=*)
                return 0
                ;;
        esac
    done

    return 1
}

uses_parallel_flag() {
    local argument

    for argument in "$@"; do
        case "${argument}" in
            --parallel|-p)
                return 0
                ;;
        esac
    done

    return 1
}

uses_coverage_flag() {
    local argument

    for argument in "$@"; do
        case "${argument}" in
            --coverage|--coverage-*|--type-coverage)
                return 0
                ;;
        esac
    done

    return 1
}

parallel_disabled() {
    case "${AI_HARNESS_PARALLEL:-}" in
        0|false|off|no|FALSE|OFF|NO)
            return 0
            ;;
    esac

    return 1
}

sail_runtime_available() {
    local app_service="${APP_SERVICE:-laravel.test}"

    [[ -x ./vendor/bin/sail ]] || return 1

    if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
        docker compose ps --status=running --services 2>/dev/null | grep -Fxq "${app_service}" && return 0
    fi

    if command -v podman >/dev/null 2>&1 && podman info >/dev/null 2>&1; then
        podman compose ps --status=running --services 2>/dev/null | grep -Fxq "${app_service}" && return 0
    fi

    return 1
}

artisan_args=("$@")
phpunit_config=".ai-harness.phpunit.xml"
run_test_directly=false
test_args=()
test_bin=""

# Collision's `artisan test` always injects its own --configuration, so a second
# one (ours or the caller's) makes PHPUnit abort; run the test binary directly.
if [[ "${1:-}" == "test" ]]; then
    if uses_phpunit_configuration "$@"; then
        run_test_directly=true
        test_args=("${@:2}")
    elif [[ -f "${phpunit_config}" ]]; then
        run_test_directly=true
        test_args=("--configuration=${phpunit_config}" "${@:2}")
    fi

    if [[ "${run_test_directly}" == "true" ]]; then
        if [[ -x ./vendor/bin/pest ]]; then
            test_bin="vendor/bin/pest"
        else
            test_bin="vendor/bin/phpunit"
        fi

        # Default Pest runs to parallel. Add --parallel only when Pest is the
        # runner, paratest is installed, and Pest's plugin registry
        # (vendor/pest-plugins.json) exists — without that registry the
        # --parallel option is unregistered and `pest --parallel` aborts with
        # "Unknown option". Never parallelise the phpunit fallback or a coverage
        # run, and never double a caller-supplied parallel flag (--parallel/-p).
        # Opt out with AI_HARNESS_PARALLEL=0.
        if [[ "${test_bin}" == "vendor/bin/pest" && -x ./vendor/bin/paratest && -f ./vendor/pest-plugins.json ]] \
            && ! parallel_disabled \
            && ! uses_parallel_flag "$@" \
            && ! uses_coverage_flag "$@"; then
            test_args=("--parallel" "${test_args[@]}")
        fi
    fi
fi

if [[ "${1:-}" == "ai-harness:doctor" && ! -f vendor/autoload.php ]]; then
    printf 'ai-harness:doctor skipped: provisioning in progress; vendor/autoload.php is missing.\n' >&2
    exit 0
fi

if sail_runtime_available; then
    if [[ "${run_test_directly}" == "true" ]]; then
        exec ./vendor/bin/sail php "${test_bin}" "${test_args[@]}"
    fi

    exec ./vendor/bin/sail artisan "${artisan_args[@]}"
fi

if herd_path="$(herd_binary)"; then
    if [[ "${run_test_directly}" == "true" ]]; then
        exec "${herd_path}" php "${test_bin}" "${test_args[@]}"
    fi

    exec "${herd_path}" php artisan "${artisan_args[@]}"
fi

if [[ "${run_test_directly}" == "true" ]]; then
    exec php "${test_bin}" "${test_args[@]}"
fi

exec php artisan "${artisan_args[@]}"
