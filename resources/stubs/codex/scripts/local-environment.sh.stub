#!/usr/bin/env bash
set -euo pipefail

action="${1:-setup}"
repo_root="${CODEX_WORKTREE_PATH:-}"
herd_workspace_enabled="${AI_HARNESS_HERD_WORKSPACE_ENABLED:-{{ herd_workspace_enabled }}}"
database_base_name="{{ database_name }}"
database_charset="{{ database_charset }}"
database_collation="{{ database_collation }}"
worktree_database_created=false

if [[ -z "${repo_root}" ]]; then
    repo_root="$(git rev-parse --show-toplevel)"
fi

artisan() {
    "${repo_root}/.dev/bin/ai-harness" "$@"
}

herd_binary() {
    if command -v herd >/dev/null 2>&1; then
        command -v herd

        return 0
    fi

    local herd_path="${HOME}/Library/Application Support/Herd/bin/herd"

    if [[ -x "${herd_path}" ]]; then
        printf '%s\n' "${herd_path}"

        return 0
    fi

    return 1
}

run_host_php() {
    if command -v php >/dev/null 2>&1; then
        php "$@"

        return
    fi

    local herd_path

    if herd_path="$(herd_binary)"; then
        "${herd_path}" php "$@"

        return
    fi

    return 127
}

sail_runtime_available() {
    local app_service="${APP_SERVICE:-laravel.test}"

    [[ -x ./vendor/bin/sail ]] || return 1

    if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
        docker compose ps --status=running --services 2>/dev/null | grep -Fxq "${app_service}" && return 0
    fi

    if command -v podman >/dev/null 2>&1 && podman info >/dev/null 2>&1; then
        podman compose ps --status=running --services 2>/dev/null | grep -Fxq "${app_service}" && return 0
    fi

    return 1
}

php_runtime() {
    if sail_runtime_available; then
        ./vendor/bin/sail php "$@"

        return
    fi

    if command -v php >/dev/null 2>&1; then
        php "$@"

        return
    fi

    local herd_path

    if herd_path="$(herd_binary)"; then
        "${herd_path}" php "$@"

        return
    fi

    php "$@"
}

composer_runtime_available() {
    sail_runtime_available || command -v composer >/dev/null 2>&1 || herd_binary >/dev/null 2>&1
}

composer_runtime() {
    if sail_runtime_available; then
        ./vendor/bin/sail composer "$@"

        return
    fi

    if command -v composer >/dev/null 2>&1; then
        composer "$@"

        return
    fi

    local herd_path

    if herd_path="$(herd_binary)"; then
        "${herd_path}" composer "$@"

        return
    fi

    composer "$@"
}

codex_workspace_requested() {
    [[ "${WORKTREE_PROFILE:-}" == "codex" ]]
}

feature_flag_enabled() {
    local value

    value="$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')"

    case "${value}" in
        1|true|yes|on)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

herd_workspace_env_value() {
    if [[ -n "${AI_HARNESS_HERD+x}" ]]; then
        printf '%s\n' "${AI_HARNESS_HERD}"

        return 0
    fi

    if [[ -f .env ]]; then
        file_env_value .env AI_HARNESS_HERD && return 0
    fi

    return 1
}

herd_workspace_config_status() {
    [[ -f config/ai-harness.php ]] || return 2

    local previous_config_path previous_config_path_was_set status

    previous_config_path_was_set="${AI_HARNESS_CONFIG_PATH+x}"
    previous_config_path="${AI_HARNESS_CONFIG_PATH:-}"

    export AI_HARNESS_CONFIG_PATH="${repo_root}/config/ai-harness.php"

    set +e
    # shellcheck disable=SC2016
    run_host_php -r '
        function env($key, $default = null) {
            $value = getenv((string) $key);

            if ($value === false) {
                return $default;
            }

            return match (strtolower((string) $value)) {
                "true", "(true)" => true,
                "false", "(false)" => false,
                "empty", "(empty)" => "",
                "null", "(null)" => null,
                default => $value,
            };
        }

        try {
            $config = require getenv("AI_HARNESS_CONFIG_PATH");
            $enabled = is_array($config) ? ($config["features"]["herd"] ?? false) : false;

            exit($enabled === true || $enabled === 1 || $enabled === "1" ? 0 : 1);
        } catch (Throwable) {
            exit(2);
        }
    '
    status=$?
    set -e

    if [[ -n "${previous_config_path_was_set}" ]]; then
        export AI_HARNESS_CONFIG_PATH="${previous_config_path}"
    else
        unset AI_HARNESS_CONFIG_PATH
    fi

    return "${status}"
}

runtime_herd_workspace_enabled() {
    local value status

    if value="$(herd_workspace_env_value)"; then
        feature_flag_enabled "${value}"

        return
    fi

    herd_workspace_config_status
    status=$?

    if [[ "${status}" -eq 0 ]]; then
        return 0
    fi

    [[ "${herd_workspace_enabled}" == "1" ]]
}

herd_platform() {
    printf '%s\n' "${AI_HARNESS_HERD_OS:-$(uname -s)}"
}

herd_workspace_requested() {
    runtime_herd_workspace_enabled || return 1
    [[ "${WORKTREE_PROFILE:-}" == "codex" ]] || return 1

    # Herd only exists on macOS, so a Herd workspace can only be requested where
    # Herd can ever run: on Darwin (even when the CLI is transiently unresolvable,
    # e.g. a minimal-PATH hook) or wherever a herd binary actually resolves. On
    # Herd-less hosts (Linux/Sail) the shared APP_URL is the servable one.
    [[ "$(herd_platform)" == "Darwin" ]] || herd_binary >/dev/null 2>&1
}

warn_herd_unavailable() {
    local warning_file

    warning_file="$(managed_state_dir)/herd-warning-emitted"

    if [[ -f "${warning_file}" ]]; then
        return
    fi

    mkdir -p "$(managed_state_dir)"
    printf 'local-environment: Herd workspace requested but Herd CLI could not be resolved; the Herd site was not linked. APP_URL already targets the per-worktree Herd site; start Herd and the next session links it automatically.\n' >&2
    touch "${warning_file}"
}

herd_workspace_available() {
    herd_workspace_requested || return 1

    if herd_binary >/dev/null 2>&1; then
        return 0
    fi

    warn_herd_unavailable

    return 1
}

herd_site_name() {
    local project_name parent_name path_hash base_name max_base_length site_name

    project_name="$(basename "${repo_root}")"
    parent_name="$(basename "$(dirname "${repo_root}")")"
    path_hash="$(printf '%s' "${repo_root}" | cksum | awk '{print $1}')"
    base_name="$(printf '%s' "${project_name}-${parent_name}" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
    max_base_length=$((63 - ${#path_hash} - 1))
    base_name="${base_name:0:${max_base_length}}"
    base_name="${base_name%-}"
    site_name="${base_name:-codex-worktree}-${path_hash}"

    printf '%s\n' "${site_name}"
}

worktree_database_name() {
    local base path_hash max_base_length database_name

    base="${database_base_name:-$(basename "${repo_root}")}"
    base="$(printf '%s' "${base}" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/_/g; s/^_+//; s/_+$//')"
    path_hash="$(printf '%s' "${repo_root}" | cksum | awk '{print $1}')"
    max_base_length=$((64 - ${#path_hash} - 1))
    database_name="${base:0:${max_base_length}}"

    if [[ -n "${database_name}" ]]; then
        database_name="${database_name}_${path_hash}"
    else
        database_name="codex_worktree_${path_hash}"
    fi

    printf '%s\n' "${database_name}"
}

worktree_testing_database_name() {
    local base path_hash suffix max_base_length database_name

    base="${database_base_name:-$(basename "${repo_root}")}"
    base="$(printf '%s' "${base}" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/_/g; s/^_+//; s/_+$//')"
    path_hash="$(printf '%s' "${repo_root}" | cksum | awk '{print $1}')"
    suffix="_testing_"
    max_base_length=$((64 - ${#path_hash} - ${#suffix}))
    database_name="${base:0:${max_base_length}}"

    if [[ -n "${database_name}" ]]; then
        database_name="${database_name}${suffix}${path_hash}"
    else
        database_name="codex_worktree_testing_${path_hash}"
    fi

    printf '%s\n' "${database_name}"
}

env_value() {
    file_env_value .env "${1}"
}

file_env_value() {
    local file="${1}" key="${2}" line value

    if [[ ! -f "${file}" ]]; then
        return 1
    fi

    line="$(grep -E "^${key}=" "${file}" | tail -n 1 || true)"
    value="${line#"${key}"=}"
    value="${value%\"}"
    value="${value#\"}"
    value="${value%\'}"
    value="${value#\'}"

    [[ "${line}" == "${key}="* ]] || return 1
    printf '%s\n' "${value}"
}

set_env_value() {
    set_env_file_value .env "${1}" "${2}"
}

set_env_file_value() {
    local file="${1}" key="${2}" value="${3}" temporary_file

    temporary_file="$(mktemp)"

    if [[ -f "${file}" ]]; then
        awk -v key="${key}" -v value="${value}" '
            BEGIN { replaced = 0 }
            $0 ~ "^" key "=" {
                print key "=" value
                replaced = 1
                next
            }
            { print }
            END {
                if (replaced == 0) {
                    print key "=" value
                }
            }
        ' "${file}" > "${temporary_file}"
    else
        printf '%s=%s\n' "${key}" "${value}" > "${temporary_file}"
    fi

    mv "${temporary_file}" "${file}"
}

managed_state_dir() {
    printf '%s\n' "${repo_root}/.codex/local-environment-state"
}

current_step_file() {
    printf '%s\n' "$(managed_state_dir)/current-step"
}

record_current_step() {
    mkdir -p "$(managed_state_dir)"
    printf '%s\n' "${1}" > "$(current_step_file)"
    printf 'local-environment: %s\n' "${1}"
}

clear_current_step() {
    rm -f "$(current_step_file)"
}

managed_database_state_file() {
    printf '%s\n' "$(managed_state_dir)/databases.env"
}

remember_database_target() {
    local role="${1}" connection="${2}" database="${3}" state_file target legacy_role legacy_connection legacy_database

    mkdir -p "$(managed_state_dir)"
    state_file="$(managed_database_state_file)"
    target="DATABASE_TARGET=${connection}|${database}"

    if [[ -f "${state_file}" ]] && ! grep -q '^DATABASE_TARGET=' "${state_file}"; then
        for legacy_role in APP TEST; do
            legacy_connection="$(file_env_value "${state_file}" "${legacy_role}_DB_CONNECTION" || true)"
            legacy_database="$(file_env_value "${state_file}" "${legacy_role}_DB_DATABASE" || true)"

            if [[ -n "${legacy_connection}" && -n "${legacy_database}" ]]; then
                printf 'DATABASE_TARGET=%s|%s\n' "${legacy_connection}" "${legacy_database}" >> "${state_file}"
            fi
        done
    fi

    if [[ ! -f "${state_file}" ]] || ! grep -Fqx "${target}" "${state_file}"; then
        printf '%s\n' "${target}" >> "${state_file}"
    fi

    set_env_file_value "${state_file}" "${role}_DB_CONNECTION" "${connection}"
    set_env_file_value "${state_file}" "${role}_DB_DATABASE" "${database}"
}

restore_managed_file() {
    local target="${1}" backup="${2}" checksum_file="${3}" expected_checksum current_checksum

    [[ -f "${backup}" ]] || return 0

    if [[ ! -f "${checksum_file}" ]]; then
        printf 'local-environment: leaving %s unchanged because no managed checksum exists.\n' "${target}" >&2

        return 0
    fi

    expected_checksum="$(cat "${checksum_file}")"
    current_checksum="$(cksum "${target}" 2>/dev/null || true)"

    if [[ "${current_checksum}" == "${expected_checksum}" ]]; then
        mv "${backup}" "${target}"
        rm -f "${checksum_file}"
    else
        printf 'local-environment: leaving modified %s in place; original backup remains at %s.\n' "${target}" "${backup}" >&2
    fi
}

cleanup_managed_state_dir() {
    local state_dir

    state_dir="$(managed_state_dir)"

    if [[ -d "${state_dir}" ]]; then
        rmdir "${state_dir}" 2>/dev/null || true
    fi
}

managed_phpunit_config_file() {
    printf '%s\n' ".ai-harness.phpunit.xml"
}

configure_phpunit_database() {
    local connection="${1}" database="${2}" config_file

    [[ -f phpunit.xml ]] || return 0

    config_file="$(managed_phpunit_config_file)"
    mkdir -p "$(dirname "${config_file}")"

    # shellcheck disable=SC2016
    AI_HARNESS_TEST_DB_CONNECTION="${connection}" \
    AI_HARNESS_TEST_DB_DATABASE="${database}" \
    AI_HARNESS_PHPUNIT_CONFIG="${config_file}" \
    php_runtime -r '
        $sourcePath = "phpunit.xml";
        $targetPath = getenv("AI_HARNESS_PHPUNIT_CONFIG");
        $connection = getenv("AI_HARNESS_TEST_DB_CONNECTION") ?: "sqlite";
        $database = getenv("AI_HARNESS_TEST_DB_DATABASE");

        if (! is_string($targetPath) || $targetPath === "") {
            fwrite(STDERR, "Missing generated PHPUnit config path.\n");
            exit(2);
        }

        if (! is_string($database) || $database === "") {
            fwrite(STDERR, "Missing testing database name.\n");
            exit(2);
        }

        $document = new DOMDocument();
        $document->preserveWhiteSpace = true;
        $document->formatOutput = true;

        if (! $document->load($sourcePath)) {
            fwrite(STDERR, "Unable to read phpunit.xml.\n");
            exit(2);
        }

        $php = $document->getElementsByTagName("php")->item(0);

        if (! $php instanceof DOMElement) {
            $php = $document->createElement("php");
            $document->documentElement?->appendChild($php);
        }

        $setEnv = function (string $name, string $value) use ($document, $php): void {
            foreach ($php->getElementsByTagName("env") as $env) {
                if ($env instanceof DOMElement && $env->getAttribute("name") === $name) {
                    $env->setAttribute("value", $value);
                    $env->setAttribute("force", "true");

                    return;
                }
            }

            $env = $document->createElement("env");
            $env->setAttribute("name", $name);
            $env->setAttribute("value", $value);
            $env->setAttribute("force", "true");
            $php->appendChild($env);
        };

        $setEnv("DB_CONNECTION", $connection);
        $setEnv("DB_DATABASE", $database);
        $setEnv("DB_URL", "");

        if ($document->save($targetPath) === false) {
            fwrite(STDERR, "Unable to write generated PHPUnit config.\n");
            exit(2);
        }
    '
}

restore_phpunit_database() {
    local state_dir

    state_dir="$(managed_state_dir)"

    restore_managed_file phpunit.xml "${state_dir}/phpunit.xml.backup" "${state_dir}/phpunit.xml.cksum"
    rm -f "$(managed_phpunit_config_file)"
    cleanup_managed_state_dir
}

sqlite_database_path() {
    local database_path="${1}"

    if [[ "${database_path}" = /* ]]; then
        printf '%s\n' "${database_path}"

        return
    fi

    printf '%s\n' "${repo_root}/${database_path}"
}

configure_worktree_environment() {
    local connection database_name sqlite_path sqlite_full_path

    codex_workspace_requested || return 0
    [[ -f .env ]] || return 0
    worktree_database_created=false

    if herd_workspace_requested; then
        set_env_value APP_URL "https://$(herd_site_name).test"
    fi

    connection="$(env_value DB_CONNECTION || true)"
    connection="${connection:-sqlite}"
    database_name="$(worktree_database_name)"
    set_env_value DB_URL ""

    case "${connection}" in
        sqlite)
            sqlite_path="database/${database_name}.sqlite"
            sqlite_full_path="$(sqlite_database_path "${sqlite_path}")"
            set_env_value DB_DATABASE "${sqlite_path}"
            mkdir -p "$(dirname "${sqlite_full_path}")"
            if [[ ! -f "${sqlite_full_path}" ]]; then
                worktree_database_created=true
            fi
            touch "${sqlite_full_path}"
            remember_database_target APP "${connection}" "${sqlite_path}"
            ;;
        mysql|mariadb)
            set_env_value DB_DATABASE "${database_name}"
            create_mysql_database "${database_name}"
            remember_database_target APP "${connection}" "${database_name}"
            ;;
        *)
            printf 'local-environment: unsupported DB_CONNECTION=%s for managed Codex worktree.\n' "${connection}" >&2
            return 1
            ;;
    esac

    configure_worktree_testing_database "${connection}"
}

configure_worktree_testing_database() {
    local connection="${1}" testing_database_name sqlite_path sqlite_full_path

    testing_database_name="$(worktree_testing_database_name)"

    case "${connection}" in
        sqlite)
            sqlite_path="database/${testing_database_name}.sqlite"
            sqlite_full_path="$(sqlite_database_path "${sqlite_path}")"
            set_env_value AI_HARNESS_TEST_DB_DATABASE "${sqlite_path}"
            mkdir -p "$(dirname "${sqlite_full_path}")"
            if [[ ! -f "${sqlite_full_path}" ]]; then
                worktree_database_created=true
            fi
            touch "${sqlite_full_path}"
            remember_database_target TEST "${connection}" "${sqlite_path}"
            configure_phpunit_database "${connection}" "${sqlite_path}"
            ;;
        mysql|mariadb)
            set_env_value AI_HARNESS_TEST_DB_DATABASE "${testing_database_name}"
            create_mysql_database "${testing_database_name}"
            remember_database_target TEST "${connection}" "${testing_database_name}"
            configure_phpunit_database "${connection}" "${testing_database_name}"
            ;;
        *)
            printf 'local-environment: unsupported DB_CONNECTION=%s for managed Codex testing database.\n' "${connection}" >&2
            return 1
            ;;
    esac
}

migrate_testing_database() {
    local connection testing_database

    codex_workspace_requested || return 0
    [[ -f artisan ]] || return 0
    [[ -f .env ]] || return 0

    connection="$(env_value DB_CONNECTION || true)"
    connection="${connection:-sqlite}"
    testing_database="$(env_value AI_HARNESS_TEST_DB_DATABASE || true)"

    [[ -n "${testing_database}" ]] || return 0

    DB_CONNECTION="${connection}" \
    DB_DATABASE="${testing_database}" \
    DB_URL="" \
    artisan migrate --env=testing --force --ansi
}

create_mysql_database() {
    local database_name="${1}" creation_status

    # shellcheck disable=SC2016
    creation_status="$(AI_HARNESS_DB_HOST="$(env_value DB_HOST || printf '127.0.0.1')" \
    AI_HARNESS_DB_PORT="$(env_value DB_PORT || printf '3306')" \
    AI_HARNESS_DB_USERNAME="$(env_value DB_USERNAME || printf 'root')" \
    AI_HARNESS_DB_PASSWORD="$(env_value DB_PASSWORD || true)" \
    AI_HARNESS_DB_DATABASE="${database_name}" \
    AI_HARNESS_DB_CHARSET="${database_charset}" \
    AI_HARNESS_DB_COLLATION="${database_collation}" \
    php_runtime -r '
        $database = getenv("AI_HARNESS_DB_DATABASE");
        $charset = getenv("AI_HARNESS_DB_CHARSET") ?: "utf8mb4";
        $collation = getenv("AI_HARNESS_DB_COLLATION") ?: "utf8mb4_unicode_ci";

        foreach ([$database, $charset, $collation] as $value) {
            if (! is_string($value) || preg_match("/^[A-Za-z0-9_]+$/", $value) !== 1) {
                fwrite(STDERR, "Invalid database identifier.\n");
                exit(2);
            }
        }

        $dsn = sprintf(
            "mysql:host=%s;port=%s",
            getenv("AI_HARNESS_DB_HOST") ?: "127.0.0.1",
            getenv("AI_HARNESS_DB_PORT") ?: "3306"
        );

        $pdo = new PDO($dsn, getenv("AI_HARNESS_DB_USERNAME") ?: "root", getenv("AI_HARNESS_DB_PASSWORD") ?: "");
        $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
        $statement = $pdo->prepare("SELECT SCHEMA_NAME FROM INFORMATION_SCHEMA.SCHEMATA WHERE SCHEMA_NAME = ?");
        $statement->execute([$database]);
        $created = $statement->fetchColumn() === false;
        $pdo->exec(sprintf("CREATE DATABASE IF NOT EXISTS `%s` CHARACTER SET %s COLLATE %s", $database, $charset, $collation));
        fwrite(STDOUT, $created ? "created\n" : "existing\n");
    ')"

    if [[ "${creation_status}" == "created" ]]; then
        worktree_database_created=true
    fi
}

drop_worktree_database() {
    local connection database_name testing_database_name configured_database configured_testing_database state_file status

    codex_workspace_requested || return 0

    state_file="$(managed_database_state_file)"

    if [[ -f "${state_file}" ]]; then
        status=0

        if grep -q '^DATABASE_TARGET=' "${state_file}"; then
            while IFS='|' read -r connection configured_database; do
                drop_recorded_database "${connection}" "${configured_database}" || status=$?
            done < <(sed -n 's/^DATABASE_TARGET=//p' "${state_file}")
        else
            drop_recorded_database \
                "$(file_env_value "${state_file}" APP_DB_CONNECTION || true)" \
                "$(file_env_value "${state_file}" APP_DB_DATABASE || true)" || status=$?

            drop_recorded_database \
                "$(file_env_value "${state_file}" TEST_DB_CONNECTION || true)" \
                "$(file_env_value "${state_file}" TEST_DB_DATABASE || true)" || status=$?
        fi

        if [[ "${status}" -eq 0 ]]; then
            rm -f "${state_file}"
        fi

        return "${status}"
    fi

    [[ -f .env ]] || return 0

    connection="$(env_value DB_CONNECTION || true)"
    connection="${connection:-sqlite}"
    database_name="$(worktree_database_name)"
    testing_database_name="$(worktree_testing_database_name)"
    configured_database="$(env_value DB_DATABASE || true)"
    configured_testing_database="$(env_value AI_HARNESS_TEST_DB_DATABASE || true)"

    case "${connection}" in
        sqlite)
            if [[ "${configured_testing_database}" == "database/${testing_database_name}.sqlite" || "${configured_testing_database}" == */"${testing_database_name}.sqlite" ]]; then
                remove_recorded_sqlite_database "${configured_testing_database}"
            fi

            if [[ "${configured_database}" == "database/${database_name}.sqlite" || "${configured_database}" == */"${database_name}.sqlite" ]]; then
                remove_recorded_sqlite_database "${configured_database}"
            fi
            ;;
        mysql|mariadb)
            if [[ "${configured_testing_database}" == "${testing_database_name}" ]]; then
                drop_mysql_database "${testing_database_name}"
            fi

            if [[ "${configured_database}" == "${database_name}" ]]; then
                drop_mysql_database "${database_name}"
            fi
            ;;
    esac
}

remove_recorded_sqlite_database() {
    local database="${1}" sqlite_path app_path test_path

    sqlite_path="$(sqlite_database_path "${database}")"
    app_path="$(sqlite_database_path "database/$(worktree_database_name).sqlite")"
    test_path="$(sqlite_database_path "database/$(worktree_testing_database_name).sqlite")"

    case "${sqlite_path}" in
        "${app_path}"|"${test_path}")
            rm -f "${sqlite_path}"
            ;;
        *)
            printf 'local-environment: refusing to remove unmanaged sqlite database path: %s\n' "${sqlite_path}" >&2
            return 1
            ;;
    esac
}

drop_recorded_database() {
    local connection="${1}" database="${2}"

    [[ -n "${connection}" ]] || return 0
    [[ -n "${database}" ]] || return 0

    case "${connection}" in
        sqlite)
            remove_recorded_sqlite_database "${database}"
            ;;
        mysql|mariadb)
            drop_mysql_database "${database}"
            ;;
    esac
}

drop_mysql_database() {
    local database_name="${1}"

    # shellcheck disable=SC2016
    AI_HARNESS_DB_HOST="$(env_value DB_HOST || printf '127.0.0.1')" \
    AI_HARNESS_DB_PORT="$(env_value DB_PORT || printf '3306')" \
    AI_HARNESS_DB_USERNAME="$(env_value DB_USERNAME || printf 'root')" \
    AI_HARNESS_DB_PASSWORD="$(env_value DB_PASSWORD || true)" \
    AI_HARNESS_DB_DATABASE="${database_name}" \
    php_runtime -r '
        $database = getenv("AI_HARNESS_DB_DATABASE");

        if (! is_string($database) || preg_match("/^[A-Za-z0-9_]+$/", $database) !== 1) {
            fwrite(STDERR, "Invalid database identifier.\n");
            exit(2);
        }

        $dsn = sprintf(
            "mysql:host=%s;port=%s",
            getenv("AI_HARNESS_DB_HOST") ?: "127.0.0.1",
            getenv("AI_HARNESS_DB_PORT") ?: "3306"
        );

        $pdo = new PDO($dsn, getenv("AI_HARNESS_DB_USERNAME") ?: "root", getenv("AI_HARNESS_DB_PASSWORD") ?: "");
        $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
        $pdo->exec(sprintf("DROP DATABASE IF EXISTS `%s`", $database));
    '
}

herd_link_pending_file() {
    printf '%s\n' "$(managed_state_dir)/herd-link-pending"
}

herd_linked_site_file() {
    printf '%s\n' "$(managed_state_dir)/herd-linked-site"
}

remember_linked_herd_site() {
    mkdir -p "$(managed_state_dir)"
    printf '%s\n' "${1}" > "$(herd_linked_site_file)"
}

linked_herd_site() {
    local expected_site site_file site_name app_url

    expected_site="$(herd_site_name)"
    site_file="$(herd_linked_site_file)"

    if [[ -f "${site_file}" ]]; then
        site_name="$(head -n 1 "${site_file}")"

        if [[ "${site_name}" == "${expected_site}" ]]; then
            printf '%s\n' "${site_name}"

            return 0
        fi
    fi

    # Older generated scripts did not record a linked-site marker. Preserve
    # cleanup for those worktrees when their managed APP_URL still identifies
    # the deterministic Herd site, even if the Herd feature is now disabled.
    app_url="$(env_value APP_URL || true)"

    case "${app_url}" in
        "http://${expected_site}.test"|"https://${expected_site}.test")
            printf '%s\n' "${expected_site}"

            return 0
            ;;
    esac

    if herd_workspace_requested; then
        printf '%s\n' "${expected_site}"

        return 0
    fi

    return 1
}

link_herd_workspace() {
    local herd_path site_name

    herd_workspace_requested || return 0

    if ! herd_path="$(herd_binary)"; then
        warn_herd_unavailable
        mkdir -p "$(managed_state_dir)"
        touch "$(herd_link_pending_file)"

        return 0
    fi

    site_name="$(herd_site_name)"

    "${herd_path}" link "${site_name}" --no-interaction
    remember_linked_herd_site "${site_name}"
    "${herd_path}" secure "${site_name}"

    rm -f "$(herd_link_pending_file)" "$(managed_state_dir)/herd-warning-emitted"
    cleanup_managed_state_dir
}

unlink_herd_workspace() {
    local herd_path output site_name status unsecure_output unsecure_status

    if [[ -f "$(herd_link_pending_file)" && ! -f "$(herd_linked_site_file)" ]]; then
        rm -f "$(herd_link_pending_file)" "$(managed_state_dir)/herd-warning-emitted"
        cleanup_managed_state_dir

        return 0
    fi

    if ! site_name="$(linked_herd_site)"; then
        return 0
    fi

    if ! herd_path="$(herd_binary)"; then
        printf 'local-environment: unable to unlink recorded Herd site %s because the Herd CLI is unavailable.\n' "${site_name}" >&2

        return 1
    fi

    set +e
    unsecure_output="$("${herd_path}" unsecure "${site_name}" 2>&1)"
    unsecure_status=$?
    set -e

    if [[ "${unsecure_status}" -ne 0 ]] && ! printf '%s\n' "${unsecure_output}" | grep -Eiq '(not secured|not found|does not exist|no .*certificate)'; then
        printf 'local-environment: Herd could not fully unsecure %s: %s\n' "${site_name}" "${unsecure_output}" >&2
    fi

    set +e
    output="$("${herd_path}" unlink "${site_name}" 2>&1)"
    status=$?
    set -e

    if [[ "${status}" -eq 0 ]]; then
        if [[ -n "${output}" ]]; then
            printf '%s\n' "${output}"
        fi

        rm -f "$(herd_linked_site_file)" "$(herd_link_pending_file)" "$(managed_state_dir)/herd-warning-emitted"
        cleanup_managed_state_dir

        return 0
    fi

    if printf '%s\n' "${output}" | grep -Eiq '(not found|not linked|does not exist|no .*link)'; then
        rm -f "$(herd_linked_site_file)" "$(herd_link_pending_file)" "$(managed_state_dir)/herd-warning-emitted"
        cleanup_managed_state_dir

        return 0
    fi

    printf '%s\n' "${output}" >&2

    return "${status}"
}

app_key_missing() {
    if [[ ! -f .env ]]; then
        return 1
    fi

    local app_key_line
    app_key_line="$(grep -E '^APP_KEY=' .env | tail -n 1 || true)"

    local app_key="${app_key_line#APP_KEY=}"
    app_key="${app_key%\"}"
    app_key="${app_key#\"}"
    app_key="${app_key%\'}"
    app_key="${app_key#\'}"

    [[ -z "${app_key}" ]]
}

case "${action}" in
    setup)
        cd "${repo_root}"

        record_current_step "link Herd workspace"
        link_herd_workspace

        record_current_step "prepare environment file"
        if [[ ! -f .env && -f .env.example ]]; then
            cp .env.example .env
        fi

        record_current_step "configure worktree environment"
        configure_worktree_environment

        record_current_step "install Composer dependencies"
        if [[ ! -f vendor/autoload.php && -f composer.json ]] && composer_runtime_available; then
            composer_runtime install --no-interaction --prefer-dist
        fi

        record_current_step "generate application key"
        if [[ -f artisan ]] && app_key_missing; then
            artisan key:generate --ansi
        fi

        record_current_step "migrate application database"
        if [[ -f artisan ]]; then
            DB_URL="" artisan migrate --force --ansi
        fi

        record_current_step "migrate testing database"
        migrate_testing_database

        record_current_step "run harness doctor"
        if [[ -f artisan ]]; then
            artisan ai-harness:doctor
        fi

        clear_current_step
        ;;
    link-herd)
        cd "${repo_root}"

        link_herd_workspace
        ;;
    heal-env)
        cd "${repo_root}"

        configure_worktree_environment

        if [[ "${worktree_database_created}" == true && -f artisan ]]; then
            DB_URL="" artisan migrate --force --ansi
            migrate_testing_database
        fi
        ;;
    cleanup)
        cd "${repo_root}"

        status=0
        drop_worktree_database || status=$?
        restore_phpunit_database || status=$?
        unlink_herd_workspace || status=$?

        exit "${status}"
        ;;
    *)
        printf 'local-environment: unknown action %s\n' "${action}" >&2
        exit 2
        ;;
esac
