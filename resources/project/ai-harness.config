# AI Harness project configuration.
# Later files override earlier files: .dist, .config, then .local.
# Linked local worktrees also inherit the primary checkout's .local before their own.
# Personal application settings belong in .ai-harness.config.local, for example:
# local_env.DB_PORT=3307 (existing host database)
# local_env.FORWARD_DB_PORT=3307 (harness-managed Sail MySQL)
# Run setup after changing local_env settings. Cloud execution ignores them.

runtime=native
services=none
agents=codex,claude

# With services=sail, an empty list starts the complete Sail stack.
sail_services=

herd_secure=true
herd_php=
valet_secure=true
valet_php=
worktrees=true

# Cloud execution uses native tools and local services, independent of Herd/Valet/Sail.
cloud=true
cloud_services=mysql
cloud_migrate=false
cloud_seed=false
cloud_build=false
cloud_browser=false
