# AI Harness project configuration.
# Later files override earlier files: .dist, .config, then .local.

runtime=native
services=none
agents=codex,claude

# With services=sail, an empty list starts the complete Sail stack.
sail_services=

herd_secure=true
herd_php=
worktrees=true

# Cloud execution uses native tools and local services, independent of Herd/Sail.
cloud=true
cloud_services=mysql
cloud_migrate=false
cloud_seed=false
cloud_build=false
cloud_browser=false
