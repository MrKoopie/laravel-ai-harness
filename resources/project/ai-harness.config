# AI Harness project configuration.
# Later files override earlier files: .dist, .config, .global, then .local.
# Scalar keys support init parameters (underscores become hyphens).
# Use repeatable --local-env=NAME=VALUE for application overrides.
# Exported AI_HARNESS_* configuration values override files for each command;
# AI_HARNESS_LOCAL_ENV carries a JSON object of local_env string values.
# Process selections are not saved here; generated agent settings preserve them.
# Linked local worktrees inherit the primary checkout's .global and .local defaults.
# Personal application settings belong in .ai-harness.config.local or .global, for example:
# local_env.DB_PORT=3307 (existing host database)
# local_env.FORWARD_DB_PORT=3307 (harness-managed Sail MySQL)
# Run setup after changing local_env settings. Cloud execution ignores them.

runtime=native

# auto preserves existing database behavior; mysql can use an existing local server.
db_connection=auto
agents=codex,claude

# Nonempty services enable Sail for any runtime. Empty: full stack for runtime=sail,
# no containers for host PHP. Include mysql for isolated Sail databases.
sail_services=

# Site settings apply to Herd, Valet, and Yerd; native, Sail, and cloud ignore them.
# Empty php_version preserves the existing selection.
site_secure=true
php_version=
worktrees=true

# Cloud execution uses native tools and local services, independent of Herd/Valet/Sail.
cloud=true
cloud_services=mysql
cloud_migrate=false
cloud_seed=false
cloud_build=false
cloud_browser=false
